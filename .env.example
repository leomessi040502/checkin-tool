# 复制为 .env.local 后填写（*.local 已被 .gitignore 忽略）
# 生产环境不读这个文件：线上由 GitHub Actions 的 Variables/Secrets 注入，见 deploy.yml

# 必填（本地开发）：Supabase 项目地址
# 生产环境固定走同源 /api/supabase 反代，构建时不读它
VITE_SUPABASE_URL=https://your-project.supabase.co

# 必填：Supabase publishable(anon) key，受 RLS 保护、并非机密
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key
